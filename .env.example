# AI provider: demo | deepseek | yandexgpt | openrouter (demo используется, если ключ не задан)
AI_PROVIDER=demo
AI_API_KEY=

# YandexGPT (только если AI_PROVIDER=yandexgpt)
YC_FOLDER_ID=

# Бесплатный запасной AI через OpenRouter (модели :free).
# Зарегистрируйтесь на openrouter.ai → Keys → создайте ключ и вставьте сюда.
# Если задан — используется, когда основной провайдер недоступен (нет баланса и т.п.)
OPENROUTER_API_KEY=
# Модель OpenRouter (по умолчанию qwen/qwen3.8-27b:free — бесплатные модели с суффиксом :free)
OPENROUTER_MODEL=

# Погода: если ключ не задан, используется открытый Open-Meteo, при недоступности — demo-данные
WEATHER_API_KEY=

